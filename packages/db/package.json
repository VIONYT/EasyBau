{
  "name": "@easybau/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./test-support": {
      "source": "./src/test-support.ts",
      "types": "./src/test-support.ts",
      "default": "./dist/test-support.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --conditions=source src/cli/migrate.ts"
  },
  "dependencies": {
    "@easybau/config": "workspace:*",
    "postgres": "4.1.1"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
