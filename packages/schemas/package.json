{
  "name": "@easybau/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API contracts (zod) shared by server and web app.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "source": "./src/constants.ts",
      "types": "./src/constants.ts",
      "default": "./dist/constants.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
