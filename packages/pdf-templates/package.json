{
  "name": "@opc/pdf-templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PDF/A-3 documents with Typst (letter per DIN 5008 Form B, A4). Fonts and templates are part of the package.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "@opc/domain": "workspace:*",
    "@opc/schemas": "workspace:*",
    "uqr": "0.1.3"
  }
}
