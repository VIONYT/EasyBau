{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["BASE_URL", "CHROMIUM_PATH", "SETUP_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
