{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "BASE_URL",
    "CHROMIUM_PATH",
    "DATABASE_URL",
    "E2E_DEVICE",
    "SCREENSHOT_DIR",
    "SETUP_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
