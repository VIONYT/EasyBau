# Reverse proxy and static file server. Only container exposed to the outside.
{
	admin off
	# Behind another reverse proxy (compose.traefik.yaml) set TRUSTED_PROXIES, so the client IP
	# from X-Forwarded-For reaches the app (rate limits). Default trusts nobody but loopback.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$APP_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
		-Server
	}
	# The original of an Eingangsrechnung may be shown in a frame of the app itself (PDF preview
	# next to the data, P2.4); everything else must never be framed.
	@framable path_regexp framable ^/api/v1/incoming-invoices/[0-9a-f-]+/original$
	header @framable {
		defer
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; frame-ancestors 'self'"
	}
	@notFramable not path_regexp notframable ^/api/v1/incoming-invoices/[0-9a-f-]+/original$
	header @notFramable {
		defer
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	@backend path /api/* /healthz /readyz
	handle @backend {
		reverse_proxy app:3000
	}

	handle {
		root * /srv
		# App shell and service worker (ADR 0010): always revalidate, so updates arrive promptly;
		# hashed build files never change.
		@revalidate path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @revalidate Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
