# ------------------------------------------------------------------
# OpenPlancraft (Arbeitstitel) – Konfiguration für docker compose
# Kopieren nach .env und anpassen: cp .env.example .env
# ------------------------------------------------------------------

# Öffentliche Adresse. "localhost" = lokaler Test (selbstsigniertes Zertifikat).
# Für einen Server: Domain eintragen, z. B. erp.meine-firma.de (Caddy holt automatisch ein Zertifikat).
APP_DOMAIN=localhost

# Anzeigename der Anwendung (Branding zentral, siehe ADR 0001).
APP_NAME=OpenPlancraft

# Betriebsprofil (ADR 0002):
#   compact  = API und Worker in einem Prozess (1–10 Nutzer, Server mit 2 GB RAM)
#   standard = getrennte Prozesse (10–50 Nutzer). Zusätzlich setzen:
#              COMPOSE_PROFILES=standard und APP_ROLE=api
PROFILE=compact
APP_ROLE=all
# COMPOSE_PROFILES=standard

# Datenbank. Passwort UNBEDINGT ändern (z. B. `openssl rand -hex 24`).
POSTGRES_DB=openplancraft
POSTGRES_USER=openplancraft
POSTGRES_PASSWORD=change-me

# Hauptschlüssel für verschlüsselte Felder (2FA-Geheimnisse, IBAN). PFLICHT, mind. 32 Zeichen.
# Erzeugen mit: openssl rand -hex 32  – sicher aufbewahren, ohne ihn sind diese Daten nicht lesbar.
APP_SECRET=

# Ersteinrichtung: Ohne Angabe erscheint beim ersten Start ein zufälliger Einrichtungscode im Log
# (docker compose logs app). Optional fest vorgeben:
# SETUP_TOKEN=

# Anmeldung: Sitzungsdauer (Tage) und Abmeldung nach Inaktivität (Stunden).
SESSION_TTL_DAYS=30
SESSION_IDLE_HOURS=168
# Nur für lokale Tests ohne HTTPS auf false setzen.
COOKIE_SECURE=true

# Öffentliche Adresse (für Einladungslinks und Sicherheitsschlüssel/Passkeys).
# Standard: https://${APP_DOMAIN}. Achtung: Bei einer späteren Domain-Änderung müssen
# Sicherheitsschlüssel neu registriert werden, weil sie an die Domain gebunden sind.
# PUBLIC_URL=https://erp.meine-firma.de

# Admins müssen eine Zwei-Faktor-Anmeldung (App-Code oder Sicherheitsschlüssel) einrichten.
REQUIRE_ADMIN_MFA=true

# Datenbank-Migrationen beim Start automatisch ausführen (empfohlen).
MIGRATE_ON_START=true

# Log-Level: fatal | error | warn | info | debug
LOG_LEVEL=info

# Nur nötig, wenn Images selbst gebaut werden und ein Firmen-Proxy TLS aufbricht:
# Pfad zu einer PEM-Datei mit dem zusätzlichen CA-Zertifikat.
# EXTRA_CA_CERT=/etc/ssl/certs/firmen-proxy.pem
