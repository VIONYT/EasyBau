# ------------------------------------------------------------------
# OpenPlancraft (Arbeitstitel) – Konfiguration für docker compose
# Kopieren nach .env und anpassen: cp .env.example .env
# ------------------------------------------------------------------

# Öffentliche Adresse. "localhost" = lokaler Test (selbstsigniertes Zertifikat).
# Für einen Server: Domain eintragen, z. B. erp.meine-firma.de (Caddy holt automatisch ein Zertifikat).
APP_DOMAIN=localhost

# Anzeigename der Anwendung (Branding zentral, siehe ADR 0001).
APP_NAME=OpenPlancraft

# Betriebsprofil (ADR 0002):
#   compact  = API und Worker in einem Prozess (1–10 Nutzer, Server mit 2 GB RAM)
#   standard = getrennte Prozesse (10–50 Nutzer). Zusätzlich setzen:
#              COMPOSE_PROFILES=standard und APP_ROLE=api
PROFILE=compact
APP_ROLE=all
# COMPOSE_PROFILES=standard

# Datenbank. Passwort UNBEDINGT ändern (z. B. `openssl rand -hex 24`).
POSTGRES_DB=openplancraft
POSTGRES_USER=openplancraft
POSTGRES_PASSWORD=change-me

# Log-Level: fatal | error | warn | info | debug
LOG_LEVEL=info

# Nur nötig, wenn Images selbst gebaut werden und ein Firmen-Proxy TLS aufbricht:
# Pfad zu einer PEM-Datei mit dem zusätzlichen CA-Zertifikat.
# EXTRA_CA_CERT=/etc/ssl/certs/firmen-proxy.pem
