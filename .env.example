# ------------------------------------------------------------------
# OpenPlancraft (Arbeitstitel) – Konfiguration für docker compose
# Kopieren nach .env und anpassen: cp .env.example .env
# ------------------------------------------------------------------

# Öffentliche Adresse. "localhost" = lokaler Test (selbstsigniertes Zertifikat).
# Für einen Server: Domain eintragen, z. B. erp.meine-firma.de (Caddy holt automatisch ein Zertifikat).
APP_DOMAIN=localhost

# Anzeigename der Anwendung (Branding zentral, siehe ADR 0001).
APP_NAME=EasyBau

# Vorgebaute Images (GitHub Container Registry, amd64/arm64) statt selbst bauen:
#   APP_VERSION=1.2.3 (Release) oder edge (Entwicklungsstand), dann
#   docker compose pull && docker compose up -d --no-build
# Ohne Angabe: Tag "latest" (letztes Release) bzw. selbst bauen mit --build.
# APP_VERSION=edge
# Gleiche Version für den Prüfdienst (sonst "latest"):
# KOSIT_IMAGE_VERSION=edge
# Andere Registry/Organisation (z. B. eigener Fork):
# IMAGE_PREFIX=ghcr.io/vionyt/openplancraft

# Betriebsprofil (ADR 0002):
#   compact  = API und Worker in einem Prozess (1–10 Nutzer, Server mit 2 GB RAM)
#   standard = getrennte Prozesse (10–50 Nutzer). Zusätzlich setzen:
#              COMPOSE_PROFILES=standard und APP_ROLE=api
PROFILE=compact
APP_ROLE=all
# COMPOSE_PROFILES=standard

# Datenbank. Passwort UNBEDINGT ändern (z. B. `openssl rand -hex 24`).
POSTGRES_DB=openplancraft
POSTGRES_USER=openplancraft
POSTGRES_PASSWORD=change-me

# Hauptschlüssel für verschlüsselte Felder (2FA-Geheimnisse, IBAN). PFLICHT, mind. 32 Zeichen.
# Erzeugen mit: openssl rand -hex 32  – sicher aufbewahren, ohne ihn sind diese Daten nicht lesbar.
APP_SECRET=

# Ersteinrichtung: Ohne Angabe erscheint beim ersten Start ein zufälliger Einrichtungscode im Log
# (docker compose logs app). Optional fest vorgeben:
# SETUP_TOKEN=

# Anmeldung: Sitzungsdauer (Tage) und Abmeldung nach Inaktivität (Stunden).
SESSION_TTL_DAYS=30
SESSION_IDLE_HOURS=168
# Nur für lokale Tests ohne HTTPS auf false setzen.
COOKIE_SECURE=true

# Öffentliche Adresse (für Einladungslinks und Sicherheitsschlüssel/Passkeys).
# Standard: https://${APP_DOMAIN}. Achtung: Bei einer späteren Domain-Änderung müssen
# Sicherheitsschlüssel neu registriert werden, weil sie an die Domain gebunden sind.
# PUBLIC_URL=https://erp.meine-firma.de

# Admins müssen eine Zwei-Faktor-Anmeldung (App-Code oder Sicherheitsschlüssel) einrichten.
REQUIRE_ADMIN_MFA=true

# Größte erlaubte Datei beim Hochladen in die Projektablage (MB). Dateien liegen im Volume "files".
UPLOAD_MAX_MB=50

# E-Mail-Versand (optional, standardmäßig aus). Ohne SMTP_HOST werden keine E-Mails verschickt;
# Einladungslinks werden dann nur in der Oberfläche angezeigt.
# SMTP_SECURE=true für Port 465 (TLS), sonst STARTTLS (Port 587, Pflicht).
# SMTP_HOST=smtp.example.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=buero@example.de
# SMTP_PASSWORD=          (oder SMTP_PASSWORD_FILE=/run/secrets/smtp_password)
# SMTP_FROM="Muster Bau GmbH <buero@example.de>"

# Rechnungseingang per E-Mail (optional, Standard aus): Jede Firma kann unter Einstellungen ›
# Rechnungseingang ein IMAP-Postfach eintragen (z. B. rechnungen@firma.de). Die App ruft es alle
# INCOMING_MAIL_INTERVAL_MINUTES Minuten ab und übernimmt Rechnungsanhänge (PDF, XML, JPG, PNG)
# nach „Eingangsrechnungen › Zu prüfen“. Ohne Freischaltung baut die App nie eine Verbindung auf.
# INCOMING_MAIL_ENABLED=false
# INCOMING_MAIL_INTERVAL_MINUTES=5

# E-Rechnung (Dienst "kosit", ADR 0007): Jede Rechnung wird beim Festschreiben als ZUGFeRD/XRechnung
# erzeugt und vom KoSIT-Validator geprüft; nur bestandene Rechnungen erhalten eine Nummer.
# Standard im Docker-Stack: http://kosit:8080 (nur intern erreichbar). Ohne Prüfdienst kein Festschreiben.
# KOSIT_URL=http://kosit:8080
# KOSIT_TIMEOUT_MS=20000

# Revisionssicheres Belegarchiv (ADR 0008/0009): Originale festgeschriebener Belege (PDF/A, E-Rechnung,
# Prüfbericht) werden mit Object Lock (WORM) bis zum Ende der Aufbewahrungsfrist unveränderbar abgelegt.
# Standard: mitgelieferter RustFS (Dienst "storage", Volume "archive"). Pflicht: ein Passwort für den
# App-Zugang setzen (darf schreiben und lesen, nie löschen). Der Root-Schlüssel wird automatisch erzeugt.
ARCHIVE_S3_SECRET_KEY=
# ARCHIVE_S3_ACCESS_KEY=archiv
# ARCHIVE_S3_BUCKET=belegarchiv
# Externer S3-Speicher (AWS, Hetzner, IONOS, Wasabi …) statt RustFS, Bucket mit aktiviertem Object Lock:
# COMPOSE_FILE=compose.yaml:compose.external-s3.yaml
# ARCHIVE_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# ARCHIVE_S3_REGION=eu-central-1
# ARCHIVE_S3_PATH_STYLE=true          (false für virtuelle Hosts: bucket.endpoint)
# ARCHIVE_S3_CREATE_BUCKET=false
# ARCHIVE_RETENTION_MODE=COMPLIANCE   (Standard; GOVERNANCE nur für Tests)
# Statt des Werts auch als Datei: ARCHIVE_S3_SECRET_KEY_FILE=/run/secrets/archive_secret
# Nur beim Umzug des Belegarchivs (docs/self-hosting, „Belegarchiv umziehen“): bisheriges Archiv als
# Quelle für den Archiv-Abgleich. Standard: leer (kein Umzug).
# ARCHIVE_PREVIOUS_S3_ENDPOINT=http://storage:9000
# ARCHIVE_PREVIOUS_S3_REGION=us-east-1
# ARCHIVE_PREVIOUS_S3_BUCKET=belegarchiv
# ARCHIVE_PREVIOUS_S3_ACCESS_KEY=archiv
# ARCHIVE_PREVIOUS_S3_SECRET_KEY=          (auch als ARCHIVE_PREVIOUS_S3_SECRET_KEY_FILE)
# ARCHIVE_PREVIOUS_S3_PATH_STYLE=true

# Sicherung (Dienst "backup", ADR 0005): täglich Datenbank + Ablage.
# BACKUP_TIME: Uhrzeit HH:MM (Zeitzone TZ) oder "off". BACKUP_KEEP_DAYS: Aufbewahrung in Tagen.
# BACKUP_DIR: Docker-Volume (Standard "backups") oder ein Pfad auf dem Server, z. B. /mnt/nas/openplancraft.
# Wiederherstellen: sh infra/restore.sh. Die .env (APP_SECRET!) zusätzlich getrennt sichern.
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
# BACKUP_DIR=/srv/openplancraft-backups

# Sicherung außer Haus (optional, ADR 0011): nach jeder Sicherung eine verschlüsselte Kopie mit
# restic an einen zweiten Ort (S3-Speicher in der EU, Backblaze B2, SFTP-Server, restic REST-Server).
# Verschlüsselt wird auf diesem Server; der Speicherort sieht nur verschlüsselte Daten.
# Standard: aus (leer). WICHTIG: Ohne RESTIC_PASSWORD sind die Sicherungen außer Haus wertlos –
# das Passwort getrennt aufbewahren (Passwort-Manager, Ausdruck im Tresor).
# Beispiele für RESTIC_REPOSITORY:
#   s3:https://s3.eu-central-1.amazonaws.com/firma-sicherung     (oder Hetzner, IONOS, Wasabi …)
#   b2:firma-sicherung:easybau
#   sftp:sicherung@nas.example.de:/srv/easybau                    (SSH-Schlüssel nach OFFSITE_SECRETS_DIR)
#   rest:https://nutzer:passwort@backup.example.de:8000/easybau
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=                       (oder RESTIC_PASSWORD_FILE=/run/offsite/restic-password)
# OFFSITE_S3_ACCESS_KEY=
# OFFSITE_S3_SECRET_KEY=                 (oder OFFSITE_S3_SECRET_KEY_FILE=/run/offsite/s3-secret)
# OFFSITE_S3_REGION=eu-central-1
# OFFSITE_B2_ACCOUNT_ID=
# OFFSITE_B2_ACCOUNT_KEY=
# Verzeichnis auf dem Server mit den Dateien für *_FILE (im Container /run/offsite).
# OFFSITE_SECRETS_DIR=./infra/backup/secrets
# Aufbewahrung außer Haus: tägliche, wöchentliche und monatliche Stände.
OFFSITE_KEEP_DAILY=14
OFFSITE_KEEP_WEEKLY=8
OFFSITE_KEEP_MONTHLY=24
# Ziel mit Löschsperre (restic REST-Server --append-only, rclone serve restic --append-only):
# true = dieser Server löscht nie alte Stände außer Haus, das Aufräumen geschieht am Ziel.
OFFSITE_APPEND_ONLY=false
TZ=Europe/Berlin

# Datenbank-Migrationen beim Start automatisch ausführen (empfohlen).
MIGRATE_ON_START=true

# Log-Level: fatal | error | warn | info | debug
LOG_LEVEL=info

# Nur nötig, wenn Images selbst gebaut werden und ein Firmen-Proxy TLS aufbricht:
# Pfad zu einer PEM-Datei mit dem zusätzlichen CA-Zertifikat.
# EXTRA_CA_CERT=/etc/ssl/certs/firmen-proxy.pem
